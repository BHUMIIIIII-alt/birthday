<script>

/* =========================================================
ACCOUNTS
========================================================= */

const accounts = {

    "admin@nescollege.test": {
        password: "admin123",
        role: "Administrator",
        name: "NES College Admin"
    },

    "student@nescollege.test": {
        password: "student123",
        role: "Student",
        name: "Bhumi"
    }

};


/* =========================================================
LOGIN
========================================================= */

document
.getElementById("loginForm")
.addEventListener("submit", function(e) {

    e.preventDefault();

    const email =
        document.getElementById("email").value.trim();

    const password =
        document.getElementById("password").value;

    const error =
        document.getElementById("error");

    if (
        accounts[email] &&
        accounts[email].password === password
    ) {

        localStorage.setItem(
            "nesUser",
            JSON.stringify(accounts[email])
        );

        showApp(accounts[email]);

    } else {

        error.textContent =
            "Incorrect email or password.";

    }

});


/* =========================================================
SHOW APP
========================================================= */

function showApp(user) {

    document.getElementById("loginPage").style.display =
        "none";

    document.getElementById("app").style.display =
        "block";

    document.getElementById("userName").textContent =
        user.name + " • " + user.role;

}


/* =========================================================
AUTO LOGIN
========================================================= */

const saved =
    localStorage.getItem("nesUser");

if (saved) {

    showApp(JSON.parse(saved));

}


/* =========================================================
LOGOUT
========================================================= */

document
.getElementById("logout")
.addEventListener("click", function() {

    localStorage.removeItem("nesUser");

