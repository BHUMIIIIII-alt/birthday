/* =========================================================
NAVIGATION
========================================================= */

const navs =
    document.querySelectorAll(".nav[data-page]");

const pages =
    document.querySelectorAll(".page");

const title =
    document.getElementById("title");


const pageTitles = {

    dashboard:
        "NES College Dashboard",

    students:
        "Student Management",

    attendance:
        "Attendance Management",

    marks:
        "Marks & Results",

    timetable:
        "Class Timetable",

    assignments:
        "Assignments",

    notices:
        "NES College Notices",

    fees:
        "Fees & Payments"

};


navs.forEach(nav => {

    nav.addEventListener("click", function() {

        const page =
            nav.dataset.page;

        navs.forEach(n =>
            n.classList.remove("active")
        );

        nav.classList.add("active");

        pages.forEach(p =>
            p.classList.remove("active")
        );

        document
            .getElementById(page)
            .classList.add("active");

        title.textContent =
            pageTitles[page];

        document
            .getElementById("sidebar")
            .classList.remove("open");

    });

});


