/* =========================================================
RENDER STUDENTS
========================================================= */

function renderStudents(searchText = "") {

    const table =
        document.getElementById("studentTable");

    table.innerHTML = "";

    const filtered =
        students.filter(student => {

            const text =
                (
                    student.id +
                    " " +
                    student.name +
                    " " +
                    student.email +
                    " " +
                    student.course
                ).toLowerCase();

            return text.includes(
                searchText.toLowerCase()
            );

        });


    filtered.forEach(student => {

        const row =
            document.createElement("tr");

        row.innerHTML = `

            <td>${student.id}</td>

            <td>
                <strong>${student.name}</strong>
            </td>

            <td>${student.email}</td>

            <td>${student.course}</td>

            <td>${student.year}</td>

            <td>
                <span class="badge green">
                    ${student.attendance}%
                </span>
            </td>

            <td>
                <button
                    class="btn danger"
                    onclick="deleteStudent('${student.id}')">
                    Delete
                </button>
            </td>

        `;

        table.appendChild(row);

    });


    document.getElementById("totalStudents")
        .textContent = students.length;

}


renderStudents();


/* =========================================================
SEARCH
========================================================= */

document
.getElementById("search")
.addEventListener("input", function() {

    renderStudents(this.value);

});


/* =========================================================
DELETE
========================================================= */

function deleteStudent(id) {

    if (
        !confirm(
            "Delete this student from NES College?"
        )
    ) {
        return;
    }

    students =
        students.filter(
            student => student.id !== id
        );

    saveStudents();

    renderStudents();

}


/* =========================================================
MODAL
========================================================= */

const modal =
    document.getElementById("modal");


document
.getElementById("addStudent")
.addEventListener("click", function() {

    modal.classList.add("show");

});


document
.getElementById("close")
.addEventListener("click", function() {

    modal.classList.remove("show");

});


window.addEventListener("click", function(e) {

    if (e.target === modal) {

        modal.classList.remove("show");

    }

});


/* =========================================================
ADD STUDENT
========================================================= */

document
.getElementById("studentForm")
.addEventListener("submit", function(e) {

    e.preventDefault();


    const id =
        document.getElementById("sid")
        .value.trim();


    if (
        students.some(student =>
            student.id === id
        )
    ) {

        alert(
            "This Student ID already exists."
        );

        return;

    }


    const newStudent = {

        id: id,

        name:
            document
            .getElementById("sname")
            .value.trim(),

        email:
            document
            .getElementById("semail")
            .value.trim(),

        course:
            document
            .getElementById("course")
            .value,

        year:
            document
            .getElementById("year")
            .value,

        attendance:
            Number(
                document
                .getElementById("attendance")
                .value
            )

    };


    students.push(newStudent);

    saveStudents();

    renderStudents();

    this.reset();

    modal.classList.remove("show");


    alert(
        newStudent.name +
        " has been added to NES College."
    );

});


/* =========================================================
ATTENDANCE
========================================================= */

const attendanceRecords = [

    ["Bhumi","Web Development","06 Oct 2026","Present"],
    ["Agraj","DBMS","06 Oct 2026","Present"],
    ["Rashi","Business Management","06 Oct 2026","Absent"],
    ["Abhi","Computer Networks","06 Oct 2026","Present"],
    ["Anmol","Accounting","06 Oct 2026","Present"]

];


function renderAttendance() {

    const table =
        document.getElementById(
            "attendanceTable"
        );

    table.innerHTML = "";


    attendanceRecords.forEach(
        (record,index) => {

            const row =
                document.createElement("tr");

            const present =
                record[3] === "Present";


            row.innerHTML = `

                <td>${record[0]}</td>

                <td>${record[1]}</td>

                <td>${record[2]}</td>

                <td>
                    <span
                        class="badge ${
                            present
                            ? "green"
                            : "red"
                        }"
                        id="status-${index}">
                        ${record[3]}
                    </span>
                </td>

                <td>
                    <button
                        class="btn ${
                            present
                            ? "danger"
                            : "success"
                        }"
                        onclick="toggleAttendance(${index})"
                        id="attendanceBtn-${index}">
                        ${
                            present
                            ? "Mark Absent"
                            : "Mark Present"
                        }
                    </button>
                </td>

            `;

            table.appendChild(row);

        }
    );

}


function toggleAttendance(index) {

    attendanceRecords[index][3] =
        attendanceRecords[index][3] === "Present"
        ? "Absent"
        : "Present";

    renderAttendance();

}


renderAttendance();

